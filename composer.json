{
    "name": "lukaszaleckas/laravel-correlation-id",
    "type": "library",
    "autoload": {
        "psr-4": {
            "LaravelCorrelationId\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelCorrelationId\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.15",
        "mockery/mockery": "^1.4",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^11.0",
        "slevomat/coding-standard": "^6.4",
        "squizlabs/php_codesniffer": "^3.6",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelCorrelationId\\Providers\\CorrelationIdServiceProvider"
            ]
        }
    }
}
